#!/usr/bin/env bash
# Deterministic state transitions for the two-pane workflow.
set -eu

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_DIR="$ROOT/.two-pane"
INBOX="$STATE_DIR/INBOX.md"
CONSUMING="$STATE_DIR/consuming.md"
tmp=""

cleanup() {
  if [ -n "$tmp" ]; then
    rm -f "$tmp"
  fi
}
trap cleanup EXIT HUP INT TERM

fail() {
  printf 'two-pane: %s\n' "$1" >&2
  exit 2
}

role() {
  case "${AGENT_ROLE:-main}" in
    main|expert) printf '%s\n' "${AGENT_ROLE:-main}" ;;
    *) fail "AGENT_ROLE must be main or expert" ;;
  esac
}

init_state() {
  mkdir -p "$STATE_DIR"
  if [ ! -e "$INBOX" ]; then
    : > "$INBOX"
  fi
  [ -f "$INBOX" ] || fail ".two-pane/INBOX.md must be a regular file"
  [ ! -e "$CONSUMING" ] || [ -f "$CONSUMING" ] || fail ".two-pane/consuming.md must be a regular file"
}

message_sender() {
  IFS= read -r first_line < "$1" || true
  case "$first_line" in
    "from: main") printf 'main\n' ;;
    "from: expert") printf 'expert\n' ;;
    *) fail "message has an invalid from line" ;;
  esac
}

send_message() {
  sender="$(role)"
  init_state
  [ ! -e "$CONSUMING" ] || fail "consume is incomplete"
  [ ! -s "$INBOX" ] || fail "inbox is not empty"
  [ "$#" -le 1 ] || fail "send accepts one message argument or standard input"

  tmp="$(mktemp "$STATE_DIR/.INBOX.md.tmp.XXXXXX")"
  {
    printf 'from: %s\n\n' "$sender"
    if [ "$#" -eq 1 ]; then
      printf '%s\n' "$1"
    else
      cat
    fi
  } > "$tmp"
  mv "$tmp" "$INBOX"
  tmp=""
}

take_message() {
  recipient="$(role)"
  init_state
  if [ -e "$CONSUMING" ]; then
    [ ! -s "$INBOX" ] || fail "consume is incomplete and inbox is not empty"
    sender="$(message_sender "$CONSUMING")"
    [ "$sender" != "$recipient" ] || fail "inbox message is awaiting the other role"
  else
    [ -s "$INBOX" ] || return 0
    sender="$(message_sender "$INBOX")"
    [ "$sender" != "$recipient" ] || fail "inbox message is awaiting the other role"
    mv "$INBOX" "$CONSUMING"
    : > "$INBOX"
  fi

  cat "$CONSUMING"
  rm -f "$CONSUMING"
}

usage() {
  printf 'usage: two-pane init | take | send [message]\n' >&2
  exit 2
}

case "${1:-}" in
  init)
    [ "$#" -eq 1 ] || usage
    init_state
    ;;
  take)
    [ "$#" -eq 1 ] || usage
    take_message
    ;;
  send)
    shift
    send_message "$@"
    ;;
  *) usage ;;
esac
