#!/usr/bin/env bash
# Two-pane workflow state transitions and Expert launcher.
set -eu

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_DIR="$ROOT/.2pane"
INBOX="$STATE_DIR/INBOX.md"
CONSUMING="$STATE_DIR/consuming.md"
SKILL_DIR="$ROOT/.agents/skills/two-pane-workflow"
SKILL="$SKILL_DIR/SKILL.md"
GITIGNORE="$ROOT/.gitignore"
tmp=""

cleanup() {
  if [ -n "$tmp" ]; then
    rm -f "$tmp"
  fi
}
trap cleanup EXIT HUP INT TERM

usage() {
  cat <<'EOF'
Usage: 2pane <command> [options]

Commands:
  init                       Initialize the workflow in this repository
  expert [codex-options...]  Start the Expert session
  send [message]             Send a message to the other role
  take                       Read and consume the waiting message

Options:
  -h, --help                 Show this help
EOF
}

usage_error() {
  printf '2pane: %s\n\n' "$1" >&2
  usage >&2
  exit 2
}

fail() {
  printf '2pane: %s\n' "$1" >&2
  exit 2
}

skill_content() {
  cat <<'EOF'
---
name: two-pane-workflow
description: 2pane inbox routing between Main and Expert. Use for explicit send/receive requests or AGENT_ROLE configuration.
---

<!-- Managed by ./2pane init. -->

# Two-pane workflow

The human triggers and serializes each inbox action. `AGENT_ROLE=expert` selects Expert; unset selects Main.

After any send, report its result in one line and yield until the human requests the next inbox action.

Never inspect `.2pane/` directly; trust the helper's output and exit status.

## Send

Run `./2pane send 'message'`.

## Receive

1. Run `./2pane take`. Empty output means the inbox is empty; report that and yield.
2. Complete the printed request.
3. Send only its requested result fields directly with `./2pane send 'reply'`; `send` performs the slot check.
EOF
}

init_workflow() {
  mkdir -p "$SKILL_DIR"
  [ -d "$SKILL_DIR" ] || fail ".agents/skills/two-pane-workflow must be a directory"

  tmp="$(mktemp "$SKILL_DIR/.SKILL.md.tmp.XXXXXX")"
  skill_content > "$tmp"
  if [ -e "$SKILL" ]; then
    [ -f "$SKILL" ] || fail ".agents/skills/two-pane-workflow/SKILL.md must be a regular file"
    if cmp -s "$tmp" "$SKILL"; then
      rm -f "$tmp"
      tmp=""
    elif grep -Fqx '<!-- Managed by ./2pane init. -->' "$SKILL"; then
      mv "$tmp" "$SKILL"
      tmp=""
    else
      fail ".agents/skills/two-pane-workflow/SKILL.md already exists and is not managed by 2pane"
    fi
  else
    mv "$tmp" "$SKILL"
    tmp=""
  fi

  if [ -e "$GITIGNORE" ]; then
    [ -f "$GITIGNORE" ] || fail ".gitignore must be a regular file"
    if ! grep -Fqx '.2pane/' "$GITIGNORE"; then
      [ ! -s "$GITIGNORE" ] || printf '\n' >> "$GITIGNORE"
      printf '.2pane/\n' >> "$GITIGNORE"
    fi
  else
    printf '.2pane/\n' > "$GITIGNORE"
  fi

  init_state
  printf 'Initialized two-pane workflow in %s\n' "$ROOT"
}

role() {
  case "${AGENT_ROLE:-main}" in
    main|expert) printf '%s\n' "${AGENT_ROLE:-main}" ;;
    *) fail "AGENT_ROLE must be main or expert" ;;
  esac
}

init_state() {
  mkdir -p "$STATE_DIR"
  if [ ! -e "$INBOX" ]; then
    : > "$INBOX"
  fi
  [ -f "$INBOX" ] || fail ".2pane/INBOX.md must be a regular file"
  [ ! -e "$CONSUMING" ] || [ -f "$CONSUMING" ] || fail ".2pane/consuming.md must be a regular file"
}

message_sender() {
  IFS= read -r first_line < "$1" || true
  case "$first_line" in
    "from: main") printf 'main\n' ;;
    "from: expert") printf 'expert\n' ;;
    *) fail "message has an invalid from line" ;;
  esac
}

send_message() {
  sender="$(role)"
  init_state
  [ ! -e "$CONSUMING" ] || fail "consume is incomplete"
  [ ! -s "$INBOX" ] || fail "inbox is not empty"
  [ "$#" -le 1 ] || fail "send accepts one message argument or standard input"

  tmp="$(mktemp "$STATE_DIR/.INBOX.md.tmp.XXXXXX")"
  {
    printf 'from: %s\n\n' "$sender"
    if [ "$#" -eq 1 ]; then
      printf '%s\n' "$1"
    else
      cat
    fi
  } > "$tmp"
  mv "$tmp" "$INBOX"
  tmp=""
}

take_message() {
  recipient="$(role)"
  init_state
  if [ -e "$CONSUMING" ]; then
    [ ! -s "$INBOX" ] || fail "consume is incomplete and inbox is not empty"
    sender="$(message_sender "$CONSUMING")"
    [ "$sender" != "$recipient" ] || fail "inbox message is awaiting the other role"
  else
    [ -s "$INBOX" ] || return 0
    sender="$(message_sender "$INBOX")"
    [ "$sender" != "$recipient" ] || fail "inbox message is awaiting the other role"
    mv "$INBOX" "$CONSUMING"
    : > "$INBOX"
  fi

  cat "$CONSUMING"
  rm -f "$CONSUMING"
}

launch_expert() {
  init_state
  export AGENT_ROLE=expert
  if [ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ]; then
    if command -v herdr >/dev/null 2>&1; then
      herdr pane rename "$HERDR_PANE_ID" expert || true
    fi
  fi

  CODEX_EXPERT_DEFAULTS=()
  if [ "${EXPERT_FULL:-0}" != 1 ]; then
    CODEX_EXPERT_DEFAULTS=(
      --disable apps
      --disable browser_use
      --disable computer_use
      --disable goals
      --disable image_generation
      --disable in_app_browser
      --disable multi_agent
      --disable plugins
      --disable remote_plugin
      --disable tool_suggest
      -c 'agents.enabled=false'
      -c 'personality="none"'
      -c 'tool_output_token_limit=4000'
      -c 'tools.view_image=false'
    )
  fi

  if [ "${#CODEX_EXPERT_DEFAULTS[@]}" -gt 0 ]; then
    exec codex "${CODEX_EXPERT_DEFAULTS[@]}" "$@"
  else
    exec codex "$@"
  fi
}

if [ "$#" -eq 0 ]; then
  usage
  exit 0
fi

case "$1" in
  -h|--help)
    [ "$#" -eq 1 ] || usage_error "help accepts no additional arguments"
    usage
    ;;
  init)
    [ "$#" -eq 1 ] || usage_error "init accepts no arguments"
    init_workflow
    ;;
  expert)
    shift
    launch_expert "$@"
    ;;
  take)
    [ "$#" -eq 1 ] || usage_error "take accepts no arguments"
    take_message
    ;;
  send)
    shift
    send_message "$@"
    ;;
  *)
    usage_error "unknown command: $1"
    ;;
esac
