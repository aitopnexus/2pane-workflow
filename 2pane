#!/usr/bin/env bash
# Two-pane workflow state transitions and Expert launcher.
set -eu

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_DIR="$ROOT/.2pane"
INBOX="$STATE_DIR/INBOX.md"
CONSUMING="$STATE_DIR/consuming.md"
tmp=""

cleanup() {
  if [ -n "$tmp" ]; then
    rm -f "$tmp"
  fi
}
trap cleanup EXIT HUP INT TERM

usage() {
  cat <<'EOF'
Usage: 2pane <command> [options]

Commands:
  expert [codex-options...]  Start the Expert session
  send [message]             Send a message to the other role
  take                       Read and consume the waiting message
  init                       Initialize workflow state

Options:
  -h, --help                 Show this help
EOF
}

usage_error() {
  printf '2pane: %s\n\n' "$1" >&2
  usage >&2
  exit 2
}

fail() {
  usage_error "$1"
}

role() {
  case "${AGENT_ROLE:-main}" in
    main|expert) printf '%s\n' "${AGENT_ROLE:-main}" ;;
    *) fail "AGENT_ROLE must be main or expert" ;;
  esac
}

init_state() {
  mkdir -p "$STATE_DIR"
  if [ ! -e "$INBOX" ]; then
    : > "$INBOX"
  fi
  [ -f "$INBOX" ] || fail ".2pane/INBOX.md must be a regular file"
  [ ! -e "$CONSUMING" ] || [ -f "$CONSUMING" ] || fail ".2pane/consuming.md must be a regular file"
}

message_sender() {
  IFS= read -r first_line < "$1" || true
  case "$first_line" in
    "from: main") printf 'main\n' ;;
    "from: expert") printf 'expert\n' ;;
    *) fail "message has an invalid from line" ;;
  esac
}

send_message() {
  sender="$(role)"
  init_state
  [ ! -e "$CONSUMING" ] || fail "consume is incomplete"
  [ ! -s "$INBOX" ] || fail "inbox is not empty"
  [ "$#" -le 1 ] || fail "send accepts one message argument or standard input"

  tmp="$(mktemp "$STATE_DIR/.INBOX.md.tmp.XXXXXX")"
  {
    printf 'from: %s\n\n' "$sender"
    if [ "$#" -eq 1 ]; then
      printf '%s\n' "$1"
    else
      cat
    fi
  } > "$tmp"
  mv "$tmp" "$INBOX"
  tmp=""
}

take_message() {
  recipient="$(role)"
  init_state
  if [ -e "$CONSUMING" ]; then
    [ ! -s "$INBOX" ] || fail "consume is incomplete and inbox is not empty"
    sender="$(message_sender "$CONSUMING")"
    [ "$sender" != "$recipient" ] || fail "inbox message is awaiting the other role"
  else
    [ -s "$INBOX" ] || return 0
    sender="$(message_sender "$INBOX")"
    [ "$sender" != "$recipient" ] || fail "inbox message is awaiting the other role"
    mv "$INBOX" "$CONSUMING"
    : > "$INBOX"
  fi

  cat "$CONSUMING"
  rm -f "$CONSUMING"
}

launch_expert() {
  init_state
  export AGENT_ROLE=expert
  if [ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ]; then
    if command -v herdr >/dev/null 2>&1; then
      herdr pane rename "$HERDR_PANE_ID" expert || true
    fi
  fi

  CODEX_EXPERT_DEFAULTS=()
  if [ "${EXPERT_FULL:-0}" != 1 ]; then
    CODEX_EXPERT_DEFAULTS=(
      --disable apps
      --disable browser_use
      --disable computer_use
      --disable goals
      --disable image_generation
      --disable in_app_browser
      --disable multi_agent
      --disable plugins
      --disable remote_plugin
      --disable tool_suggest
      -c 'agents.enabled=false'
      -c 'personality="none"'
      -c 'tool_output_token_limit=4000'
      -c 'tools.view_image=false'
      -c 'web_search="cached"'
    )
  fi

  if [ "${#CODEX_EXPERT_DEFAULTS[@]}" -gt 0 ]; then
    exec codex "${CODEX_EXPERT_DEFAULTS[@]}" "$@"
  else
    exec codex "$@"
  fi
}

if [ "$#" -eq 0 ]; then
  usage
  exit 0
fi

case "$1" in
  -h|--help)
    [ "$#" -eq 1 ] || usage_error "help accepts no additional arguments"
    usage
    ;;
  expert)
    shift
    launch_expert "$@"
    ;;
  init)
    [ "$#" -eq 1 ] || usage_error "init accepts no arguments"
    init_state
    ;;
  take)
    [ "$#" -eq 1 ] || usage_error "take accepts no arguments"
    take_message
    ;;
  send)
    shift
    send_message "$@"
    ;;
  *)
    usage_error "unknown command: $1"
    ;;
esac
